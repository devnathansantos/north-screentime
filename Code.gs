/** NORTH V1.1 — espelho do extrato e snapshot completo em Google Sheets.
 * Configure SPREADSHEET_ID e NORTH_TOKEN em Propriedades do script.
 * A URL /exec e o cliente são públicos; o token não é autenticação forte.
 */
const LEDGER_SHEET = 'Lancamentos';
const SNAPSHOT_SHEET = 'Snapshot';
function json_(obj) { return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON); }
function authorized_(token) { const expected = PropertiesService.getScriptProperties().getProperty('NORTH_TOKEN'); return !!expected && String(token || '') === expected; }
function spreadsheet_() { const id = PropertiesService.getScriptProperties().getProperty('SPREADSHEET_ID'); if (!id) throw new Error('Configure SPREADSHEET_ID nas propriedades do script.'); return SpreadsheetApp.openById(id); }
function ledgerSheet_() { const ss = spreadsheet_(); let sh = ss.getSheetByName(LEDGER_SHEET); if (!sh) { sh = ss.insertSheet(LEDGER_SHEET); sh.appendRow(['id','type','value','origin','originId','createdAt','idempotencyKey','description','referenceEntryId']); } return sh; }
function snapshotSheet_() { const ss = spreadsheet_(); let sh = ss.getSheetByName(SNAPSHOT_SHEET); if (!sh) { sh = ss.insertSheet(SNAPSHOT_SHEET); sh.appendRow(['updatedAt','json']); } return sh; }
function doGet(e) { try { if (!authorized_(e.parameter.token)) return json_({ok:false,error:'Token inválido.'}); const action = e.parameter.action || 'read'; if (action === 'restore') { const sh = snapshotSheet_(); if (sh.getLastRow() < 2) return json_({ok:false,error:'Nenhum snapshot completo encontrado.'}); const raw = sh.getRange(sh.getLastRow(),2).getValue(); return json_({ok:true,snapshot:JSON.parse(raw)}); } const sh = ledgerSheet_(); const rows = sh.getDataRange().getValues(); if (rows.length < 2) return json_({ok:true,entries:[]}); const headers = rows.shift(); const entries = rows.map(row => Object.fromEntries(headers.map((h,i)=>[h,row[i]]))).map(r=>({id:String(r.id),type:String(r.type),value:Number(r.value),origin:String(r.origin),originId:r.originId?String(r.originId):null,createdAt:new Date(r.createdAt).toISOString(),idempotencyKey:String(r.idempotencyKey),description:String(r.description),referenceEntryId:r.referenceEntryId?String(r.referenceEntryId):null})); return json_({ok:true,entries}); } catch(err) { return json_({ok:false,error:String(err.message||err)}); } }
function doPost(e) { const lock = LockService.getScriptLock(); try { const body = JSON.parse(e.postData.contents || '{}'); if (!authorized_(body.token)) return json_({ok:false,error:'Token inválido.'}); if (body.action !== 'sync' || !Array.isArray(body.entries) || !body.snapshot) return json_({ok:false,error:'Requisição inválida.'}); lock.waitLock(10000); const sh = ledgerSheet_(); const last = sh.getLastRow(); const ids = new Set(last > 1 ? sh.getRange(2,1,last-1,1).getValues().flat().map(String) : []); const acceptedIds = []; const rows = []; body.entries.forEach(x => { if (!x || typeof x.id !== 'string' || !Number.isSafeInteger(Number(x.value)) || !x.createdAt || !x.type) throw new Error('Lançamento inválido.'); if (!ids.has(x.id)) { ids.add(x.id); acceptedIds.push(x.id); rows.push([x.id,x.type,Number(x.value),x.origin||'',x.originId||'',x.createdAt,x.idempotencyKey||'',x.description||'',x.referenceEntryId||'']); } else acceptedIds.push(x.id); }); if (rows.length) sh.getRange(sh.getLastRow()+1,1,rows.length,rows[0].length).setValues(rows); const snapshot = body.snapshot; if (!Array.isArray(snapshot.ledger) || !Array.isArray(snapshot.missions) || !Array.isArray(snapshot.rewards) || !Array.isArray(snapshot.leisureCredits)) throw new Error('Snapshot incompleto.'); const snap = snapshotSheet_(); snap.appendRow([new Date().toISOString(), JSON.stringify(snapshot)]); return json_({ok:true,acceptedIds,inserted:rows.length}); } catch(err) { return json_({ok:false,error:String(err.message||err)}); } finally { try { lock.releaseLock(); } catch(_) {} } }
